:8080 {
	encode gzip

	handle_path /gpt/api/* {
		reverse_proxy 127.0.0.1:8001
	}

	handle_path /api/* {
		reverse_proxy 127.0.0.1:8001
	}

	handle_path /gpt/uploads/* {
		reverse_proxy 127.0.0.1:8001
	}

	handle_path /uploads/* {
		reverse_proxy 127.0.0.1:8001
	}

	handle_path /gpt/* {
		root * /var/www/durian-gpt
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /var/www/durian-gpt
		try_files {path} /index.html
		file_server
	}
}

# Docker-only bridge for RAGFlow/Dify model calls. This address is not
# routable from the public network and still requires a separate API key.
http://:18001 {
	bind 172.17.0.1
	reverse_proxy 127.0.0.1:8001
}

# Docker-only bridge from Dify to RAGFlow's private retrieval API.
http://:18002 {
	bind 172.17.0.1
	reverse_proxy 127.0.0.1:19380
}

# Docker-only OpenAI-compatible bridge to the already-running Durian vLLM.
http://:18003 {
	bind 172.17.0.1
	reverse_proxy 127.0.0.1:8010
}
