async function confirmCrop() {
  if (!cropperInstance.value) return

  const originalFile = pestImageFile.value
  if (!originalFile) {
    pushToast(t.value.noImageSelected, 'warning')
    return
  }

  try {
    const cropData = cropperInstance.value.getData(true)
    const imageData = cropperInstance.value.getImageData()
    const originalArea = Math.max(1, imageData.naturalWidth * imageData.naturalHeight)
    const cropArea = Math.max(1, cropData.width * cropData.height)
    const cropAreaRatio = cropArea / originalArea
    const cropTouchesFullImage = (
      cropAreaRatio >= 0.98
      && cropData.x <= imageData.naturalWidth * 0.01
      && cropData.y <= imageData.naturalHeight * 0.01
    )

    const canvas = cropperInstance.value.getCroppedCanvas({
      // 保留足够的病斑、虫体纹理，同时限制超大手机照片的上传体积。
      maxWidth: 2048,
      maxHeight: 2048,
      fillColor: '#fff',
      imageSmoothingEnabled: true,
      imageSmoothingQuality: 'high',
    })

    canvas.toBlob(
      async (blob) => {
        let previewUrl = originalImagePreview.value
        let analysisFile = originalFile

        if (blob) {
          previewUrl = await blobToDataURL(blob)
          if (!cropTouchesFullImage) {
            const originalBaseName = originalFile.name.replace(/\.[^.]+$/, '') || 'durian-image'
            analysisFile = new File(
              [blob],
              `${originalBaseName}-crop.jpg`,
              { type: 'image/jpeg', lastModified: Date.now() },
            )
          }
        } else {
          console.warn('裁剪预览生成失败，改用原图预览')
        }

        pestImageFile.value = analysisFile
        console.log(
          cropTouchesFullImage
            ? `未缩小裁剪区域，分析使用原图: ${originalFile.name}, ${(originalFile.size / 1024).toFixed(1)}KB`
            : `分析使用裁剪图: ${analysisFile.name}, ${(analysisFile.size / 1024).toFixed(1)}KB, 范围 ${(cropAreaRatio * 100).toFixed(1)}%`,
        )

        // 不立即发送图片。图片先作为输入框上方的 tag 等待用户确认发送，避免出现“图片 + 文本”混合消息占位。
        pestImagePreview.value = previewUrl
        closeCropperModal({ keepSelectedImage: true })
        await nextTick()
      },
      'image/jpeg',
      0.92,
    )
  } catch (error) {
    console.error('裁剪失败:', error)
    pushToast(t.value.errorConnection, 'error')
  }
}

async function classifyAndAnalyze(file, previewUrl) {
  if (isAnalyzingImage.value) {
    console.warn('图片分析正在进行，忽略重复请求')
    return
  }

  const uiLang = getCurrentUILang()

  console.log('图片分析使用语言:', uiLang)
  console.log('新版图片分析：跳过本地分类模型，直接调用视觉大模型')

  isAnalyzingImage.value = true
  isSending.value = true
  let assistantMessage = null
  let hasAnalysisResult = false

  try {
    console.log('开始视觉大模型图片分析...')
    console.log(`图片大小: ${(file.size / 1024).toFixed(1)}KB`)

    // 图片问题也要进入历史上下文，否则后续“严重吗/要不要喷药/怎么处理”无法追问。
    // 但前端展示不再强制显示“[图片]”这类占位文本；只有用户真的输入了问题，才作为图片说明显示。
    const typedImageQuestion = (userInput.value || '').trim()
    const imageQuestion = typedImageQuestion || getUITextByLang(uiLang, 'imageAnalyzePrompt') || '请分析这张榴莲图片'
    userInput.value = ''

    // 确保有对话 ID
    const imageConversationId = await createConversationIfNeeded(imageQuestion)
    if (!imageConversationId) {
      throw new Error('创建图片分析对话失败')
    }

    // 立即添加用户图片消息：图片单独展示；只有用户输入了真实问题，才显示文字说明。
    const userMsg = {
      role: 'user',
      content: typedImageQuestion,
      imageKey: `img_${Date.now()}`,
      image_url: null,
      messageType: 'image',
    }
    messages.value.push(userMsg)
    messageImages.value = {
      ...messageImages.value,
      [userMsg.imageKey]: previewUrl,
    }

    // 立即添加助手消息占位符
    assistantMessage = {
      role: 'assistant',
      content: getRuntimeText(uiLang, 'imageGeneratingWithClass') || getUITextByLang(uiLang, 'imageAnalyzing'),
      isStreaming: true,
      messageType: 'image_analysis',
      evidence: [],
      evidence_quality: 'none',
    }
    messages.value.push(assistantMessage)
    const assistantMessageIndex = messages.value.length - 1

    await scrollToBottom(true)
    await scrollToBottom(true)

    // 图片分析改为真正流式：/analyze_pest/stream2
    console.log('开始图片流式分析...')
    const analyzeFormData = new FormData()
    analyzeFormData.append('file', file)
    analyzeFormData.append('query', imageQuestion)
    analyzeFormData.append('response_language', uiLang)
    analyzeFormData.append('conversation_id', imageConversationId)

    const streamResponse = await fetch(`${API_BASE_URL}/analyze_pest/stream2`, {
      method: 'POST',
      headers: getAuthHeaders(),
      body: analyzeFormData,
    })

    if (!streamResponse.ok) {
      const text = await streamResponse.text()
      throw new Error(`图片流式分析失败: HTTP ${streamResponse.status} ${text}`)
    }

    if (!streamResponse.body) {
      throw new Error('浏览器不支持 ReadableStream，无法流式读取图片分析结果')
    }

    const reader = streamResponse.body.getReader()
    const decoder = new TextDecoder('utf-8')
    let buffer = ''
    let fullResponse = ''
    let imageUrl = null
    let activeContextCard = null
    let imageEvidence = []
    let imageEvidenceQuality = 'none'
    let tokensGenerated = 0
    let streamDone = false

    while (!streamDone) {
      const { value, done } = await reader.read()
      if (done) break

      buffer += decoder.decode(value, { stream: true })
      const events = buffer.split('\n\n')
      buffer = events.pop() || ''

      for (const eventText of events) {
        const lines = eventText
          .split('\n')
          .map(line => line.trim())
          .filter(Boolean)

        for (const line of lines) {
          if (!line.startsWith('data:')) continue

          const raw = line.slice(5).trim()
          if (!raw) continue

          if (raw === '[DONE]') {
            streamDone = true
            break
          }

          let payload
          try {
            payload = JSON.parse(raw)
          } catch (parseError) {
            console.warn('图片流式 SSE 解析失败:', raw, parseError)
            continue
          }

          if (payload.type === 'metadata') {
            imageUrl = payload.image_url || imageUrl
            imageEvidence = Array.isArray(payload.evidence) ? payload.evidence : imageEvidence
            imageEvidenceQuality = payload.evidence_quality || imageEvidenceQuality

            assistantMessage.evidence = imageEvidence
            assistantMessage.evidence_quality = imageEvidenceQuality
            updateEvidencePanelFromMessage(assistantMessage, assistantMessageIndex, { expandSidebar: false })

            if (imageUrl) {
              userMsg.image_url = imageUrl
            }

            assistantMessage.content = ''
            assistantMessage.isStreaming = true
            assistantMessage.messageType = 'image_analysis'
            messages.value = [...messages.value]
            scheduleMessagesRender(true)

            try {
              saveEvidenceCache(currentConversationId.value, evidence.value, evidenceQuality.value)
              saveEvidenceHistoryCache(currentConversationId.value)
            } catch (cacheError) {
              console.warn('参考资料缓存失败:', cacheError)
            }
          } else if (payload.type === 'content') {
            const chunk = payload.content || ''
            if (!chunk) continue

            fullResponse += chunk
            assistantMessage.content = normalizeModelOutput(fullResponse)
            assistantMessage.isStreaming = true
            assistantMessage.messageType = 'image_analysis'
            hasAnalysisResult = true

            // 每个 chunk 都强制触发 Vue 渲染。
            messages.value = [...messages.value]
            scheduleMessagesRender(true)
          } else if (payload.type === 'done') {
            tokensGenerated = Number(payload.tokens_generated || tokensGenerated || 0)
            activeContextCard = payload.active_context_card || activeContextCard
            imageUrl = payload.image_url || imageUrl
            imageEvidence = Array.isArray(payload.evidence) ? payload.evidence : imageEvidence
            imageEvidenceQuality = payload.evidence_quality || imageEvidenceQuality
            streamDone = true
          } else if (payload.type === 'error') {
            throw new Error(payload.error || '图片流式分析失败')
          }
        }
      }
    }

    const finalResponse = normalizeModelOutput(fullResponse)

    if (!finalResponse) {
      throw new Error('图片流式分析返回内容为空')
    }

    assistantMessage.content = finalResponse
    assistantMessage.active_context_card = activeContextCard || null
    assistantMessage.isStreaming = false
    assistantMessage.messageType = 'image_analysis'
    assistantMessage.evidence = imageEvidence
    assistantMessage.evidence_quality = imageEvidenceQuality
    updateEvidencePanelFromMessage(assistantMessage, assistantMessageIndex, { expandSidebar: false })
    hasAnalysisResult = true
    messages.value = [...messages.value]
    saveEvidenceCache(currentConversationId.value, evidence.value, evidenceQuality.value)
    saveEvidenceHistoryCache(currentConversationId.value)

    if (tokensGenerated) {
      totalTokens.value += tokensGenerated
    }

    await scrollToBottom(true)

    // 保存用户图片消息，不阻塞流式显示。
    saveMessageToConversation('user', imageQuestion, imageUrl || null).catch((saveUserError) => {
      console.warn('保存用户图片消息失败:', saveUserError)
    })

    // 保存助手分析消息，不阻塞流式显示。
    saveMessageToConversation(
      'assistant',
      assistantMessage.content,
      null,
      assistantMessage.active_context_card || null,
      assistantMessage.evidence || [],
      assistantMessage.evidence_quality || 'none'
    ).catch((saveAssistantError) => {
      console.warn('保存助手分析消息失败:', saveAssistantError)
    })

  } catch (error) {
    console.error('分析失败:', error)
    console.error('图片分析请求异常类型:', error?.name)
    console.error('图片分析请求异常信息:', error?.message)

    if (error?.message && (error.message.includes('NetworkError') || error.message.includes('Failed to fetch'))) {
      console.error('这通常表示请求没有拿到 HTTP 响应，可能是 Vite 代理断开、后端进程中断、CORS 或网络连接问题。')
    }

    // 只有在没有真实分析结果时才显示错误提示
    if (!hasAnalysisResult && assistantMessage) {
      assistantMessage.content = t.value.imageAnalysisFailed
      assistantMessage.isStreaming = false
      messages.value = [...messages.value]
      pushToast(t.value.imageAnalysisFailed, 'error')
    }
  } finally {
    isSending.value = false
    isAnalyzingImage.value = false
    pestImageFile.value = null
    pestImagePreview.value = null
  }
}

