function stableTextHash(text = '') {
  let hash = 0
  const value = String(text || '')
  for (let i = 0; i < value.length; i += 1) {
    hash = ((hash << 5) - hash + value.charCodeAt(i)) | 0
  }
  return String(hash)
}

function stripEvidenceContentComment(content = '') {
  return String(content || '').replace(/<!--\s*\[RAG evidence encoded\][\s\S]*?-->/gi, '').trim()
}

function extractEvidenceContentComment(content = '') {
  const rawContent = String(content || '')
  const match = rawContent.match(/<!--\s*\[RAG evidence encoded\]\s*([\s\S]*?)-->/i)
  if (!match) {
    return {
      content: rawContent,
      evidence: [],
      evidence_quality: 'none',
    }
  }

  try {
    const parsed = JSON.parse(decodeURIComponent(match[1].trim()))
    return {
      content: stripEvidenceContentComment(rawContent),
      evidence: Array.isArray(parsed.evidence) ? parsed.evidence : [],
      evidence_quality: parsed.evidence_quality || 'none',
    }
  } catch (error) {
    console.warn('Failed to parse saved RAG evidence payload:', error)
    return {
      content: stripEvidenceContentComment(rawContent),
      evidence: [],
      evidence_quality: 'none',
    }
  }
}

function getPersistableEvidenceList(evidenceList = []) {
  return Array.isArray(evidenceList)
    ? evidenceList.filter((item) => item && (item.text || item.display_text || item.translated_text))
    : []
}

function buildEvidenceContentComment(evidenceList = [], quality = 'none') {
  const persistable = getPersistableEvidenceList(evidenceList)
  if (!persistable.length) return ''

  const payload = {
    evidence: persistable,
    evidence_quality: quality || 'none',
    saved_at: Date.now(),
  }

  return `\n\n<!-- [RAG evidence encoded]\n${encodeURIComponent(JSON.stringify(payload))}\n-->`
}

function saveEvidenceCache(convId, evidenceList, quality = 'none') {
  if (!convId) return

  const payload = {
    evidence: evidenceList || [],
    evidence_quality: quality || 'none',
    saved_at: Date.now(),
  }

  localStorage.setItem(getEvidenceStorageKey(convId), JSON.stringify(payload))
}

function saveEvidenceHistoryCache(convId, messageList = messages.value) {
  if (!convId) return

  const entries = []
  let assistantIndex = 0
  for (const message of messageList || []) {
    if (message?.role !== 'assistant') continue
    assistantIndex += 1
    const messageEvidence = getPersistableEvidenceList(message.evidence)
    if (!messageEvidence.length) continue
    entries.push({
      assistant_index: assistantIndex,
      content_hash: stableTextHash(message.content || ''),
      evidence: messageEvidence,
      evidence_quality: message.evidence_quality || 'none',
    })
  }

  localStorage.setItem(
    getEvidenceHistoryStorageKey(convId),
    JSON.stringify({ entries, saved_at: Date.now() })
  )
}

function loadEvidenceCache(convId) {
  if (!convId) {
    return {
      evidence: [],
      evidence_quality: 'none',
    }
  }

  try {
    const raw = localStorage.getItem(getEvidenceStorageKey(convId))
    if (!raw) {
      return {
        evidence: [],
        evidence_quality: 'none',
      }
    }

    const parsed = JSON.parse(raw)
    return {
      evidence: Array.isArray(parsed.evidence) ? parsed.evidence : [],
      evidence_quality: parsed.evidence_quality || 'none',
    }
  } catch (error) {
    console.error('读取参考资料缓存失败:', error)
    return {
      evidence: [],
      evidence_quality: 'none',
    }
  }
}

function removeEvidenceCache(convId) {
  if (!convId) return
  localStorage.removeItem(getEvidenceStorageKey(convId))
  localStorage.removeItem(getEvidenceHistoryStorageKey(convId))
}

function loadEvidenceHistoryCache(convId) {
  if (!convId) return []

  try {
    const raw = localStorage.getItem(getEvidenceHistoryStorageKey(convId))
    if (!raw) return []
    const parsed = JSON.parse(raw)
    return Array.isArray(parsed.entries) ? parsed.entries : []
  } catch (error) {
    console.error('读取参考资料历史缓存失败:', error)
    return []
  }
}

function attachEvidenceHistoryToMessages(convId, messageList) {
  const historyEntries = loadEvidenceHistoryCache(convId)
  if (!historyEntries.length) return messageList

  const byAssistantIndex = new Map()
  const byContentHash = new Map()
  for (const entry of historyEntries) {
    if (!Array.isArray(entry.evidence) || !entry.evidence.length) continue
    byAssistantIndex.set(Number(entry.assistant_index), entry)
    if (entry.content_hash) byContentHash.set(String(entry.content_hash), entry)
  }

  let assistantIndex = 0
  return (messageList || []).map((message) => {
    if (message?.role !== 'assistant') return message
    assistantIndex += 1
    const contentHash = stableTextHash(message.content || '')
    const entry = byContentHash.get(contentHash) || byAssistantIndex.get(assistantIndex)
    if (!entry) return message
    return {
      ...message,
      evidence: entry.evidence,
      evidence_quality: entry.evidence_quality || 'none',
    }
  })
}

function getLatestMessageEvidence(messageList = messages.value) {
  for (let i = (messageList || []).length - 1; i >= 0; i -= 1) {
    const message = messageList[i]
    if (message?.role !== 'assistant') continue
    const messageEvidence = getVisibleEvidenceList(message.evidence)
    if (messageEvidence.length) {
      return {
        evidence: messageEvidence,
        evidence_quality: message.evidence_quality || 'none',
        message_index: i,
      }
    }
  }
  return {
    evidence: [],
    evidence_quality: 'none',
    message_index: null,
  }
}

