function isBadEvidenceForPanel(item) {
  const text = String(
    item?.display_text ||
    item?.text ||
    item?.index_text ||
    item?.original_text ||
    item?.evidence ||
    ''
  ).replace(/\s+/g, ' ').trim()

  if (!text) return true

  const lower = text.toLowerCase()

  // MinerU / OCR parser garbage
  const parserMarkers = [
    "'bbox'", '"bbox"', 'bbox:',
    "'spans'", '"spans"',
    "'lines'", '"lines"',
    "'para_blocks'", '"para_blocks"',
    "'discarded_blocks'", '"discarded_blocks"',
    "'page_idx'", '"page_idx"',
    "'image_path'", '"image_path"',
    "'content'", '"content"'
  ]

  let markerHits = 0
  for (const marker of parserMarkers) {
    if (lower.includes(marker)) markerHits += 1
  }
  if (markerHits >= 2) return true

  // Book preface / author responsibility / front matter
  const frontMatterMarkers = [
    '本书由',
    '主编',
    '副研究员',
    '助理研究员',
    '负责图书框架',
    '主要负责',
    '负责榴莲',
    '资料整理',
    '撰写',
    '书中系统介绍',
    '责任编辑',
    '出版'
  ]

  if (frontMatterMarkers.some(marker => text.includes(marker))) return true

  return false
}

