  const latinLetters = (value.match(/[A-Za-z]/g) || []).length
  const wordSeparators = (value.match(/[\s.,;:!?()[\]{}-]/g) || []).length
  if (latinLetters >= 24 && wordSeparators >= 4) return 'en'

  return 'unknown'
}

