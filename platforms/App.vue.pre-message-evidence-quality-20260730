function syncMarkdownTableSliders(root = null) {
  ensureMarkdownTableButtons(root)
  const scope = root || chatMessagesRef.value || document
  const wrappers = scope?.querySelectorAll?.('.markdown-table-wrap') || []

  wrappers.forEach((wrap) => {
    const scroller = wrap.querySelector('[data-table-scroll]')
    const dragbar = wrap.querySelector('[data-table-dragbar]')
    const thumb = wrap.querySelector('[data-table-dragthumb]')
    const leftButton = wrap.querySelector('[data-table-left]')
    const rightButton = wrap.querySelector('[data-table-right]')

    if (!scroller || !dragbar || !thumb) return

    if (dragbar.dataset.bound === '1') {
      updateOneTableScrollControl(wrap)
      return
    }

    let dragging = false
    let ticking = false
    let startX = 0
    let startScrollLeft = 0

    const getMaxScroll = () => {
      const table = scroller.querySelector('table')
      const tableWidth = table ? Math.ceil(table.getBoundingClientRect().width) : 0
      const contentWidth = Math.max(scroller.scrollWidth, tableWidth)
      return Math.max(0, Math.ceil(contentWidth - scroller.clientWidth))
    }

    const update = () => {
      const maxScroll = getMaxScroll()
      const scrollLeft = Math.max(0, Math.min(scroller.scrollLeft, maxScroll))
      const ratio = maxScroll > 2 ? scrollLeft / maxScroll : 0

      const barWidth = Math.max(1, dragbar.clientWidth)
      const visibleRatio = scroller.scrollWidth > 0 ? Math.min(1, scroller.clientWidth / scroller.scrollWidth) : 1
      const thumbWidth = Math.max(36, Math.floor(barWidth * visibleRatio))
      const maxThumbLeft = Math.max(0, barWidth - thumbWidth)

      thumb.style.width = `${thumbWidth}px`
      thumb.style.transform = `translateX(${Math.round(maxThumbLeft * ratio)}px)`

      if (leftButton) leftButton.disabled = maxScroll <= 2 || scrollLeft <= 2
      if (rightButton) rightButton.disabled = maxScroll <= 2 || scrollLeft >= maxScroll - 2

      wrap.classList.toggle('is-scrollable', maxScroll > 2)
      wrap.classList.toggle('at-start', scrollLeft <= 2)
      wrap.classList.toggle('at-end', scrollLeft >= maxScroll - 2)
      dragbar.classList.toggle('is-disabled', maxScroll <= 2)
    }

    const requestUpdate = () => {
      if (ticking) return
      ticking = true
      window.requestAnimationFrame(() => {
        ticking = false
        update()
      })
    }

    const setScrollFromBarX = (clientX) => {
      const maxScroll = getMaxScroll()
      if (maxScroll <= 2) return

      const rect = dragbar.getBoundingClientRect()
      const ratio = Math.max(0, Math.min(1, (clientX - rect.left) / Math.max(1, rect.width)))
      scroller.scrollLeft = Math.round(ratio * maxScroll)
      requestUpdate()
    }

    const scrollByStep = (direction) => {
      const maxScroll = getMaxScroll()
      const step = Math.max(160, Math.floor(scroller.clientWidth * 0.75))
      const next = Math.max(0, Math.min(maxScroll, scroller.scrollLeft + direction * step))
      scroller.scrollTo({ left: next, behavior: 'smooth' })
      window.setTimeout(requestUpdate, 80)
      window.setTimeout(requestUpdate, 240)
    }

    // 表格本体也允许横向拖动，不只依赖下面的条
    let tableDragging = false
    let tableStartX = 0
    let tableStartLeft = 0

    scroller.addEventListener('touchstart', (event) => {
      if (!event.touches?.[0]) return
      tableDragging = true
      tableStartX = event.touches[0].clientX
      tableStartLeft = scroller.scrollLeft
    }, { passive: true })

    scroller.addEventListener('touchmove', (event) => {
      if (!tableDragging || !event.touches?.[0]) return
      const dx = event.touches[0].clientX - tableStartX
      if (Math.abs(dx) > 4) {
        scroller.scrollLeft = tableStartLeft - dx
        requestUpdate()
      }
    }, { passive: true })

    scroller.addEventListener('touchend', () => {
      tableDragging = false
    }, { passive: true })

    scroller.addEventListener('scroll', requestUpdate, { passive: true })

    // 自定义拖动条：pointer 事件
    dragbar.addEventListener('pointerdown', (event) => {
      const maxScroll = getMaxScroll()
      if (maxScroll <= 2) return
      dragging = true
      startX = event.clientX
      startScrollLeft = scroller.scrollLeft
      event.preventDefault()
      event.stopPropagation()
      dragbar.setPointerCapture?.(event.pointerId)
      setScrollFromBarX(event.clientX)
    })

    dragbar.addEventListener('pointermove', (event) => {
      if (!dragging) return
      event.preventDefault()
      event.stopPropagation()
      const maxScroll = getMaxScroll()
      const rect = dragbar.getBoundingClientRect()
      const dx = event.clientX - startX
      const ratioDelta = dx / Math.max(1, rect.width)
      scroller.scrollLeft = Math.max(0, Math.min(maxScroll, startScrollLeft + ratioDelta * maxScroll))
      requestUpdate()
    })

    const stopPointer = (event) => {
      if (!dragging) return
      dragging = false
      event?.stopPropagation?.()
      try {
        if (event?.pointerId != null) dragbar.releasePointerCapture?.(event.pointerId)
      } catch {}
    }

    dragbar.addEventListener('pointerup', stopPointer)
    dragbar.addEventListener('pointercancel', stopPointer)
    dragbar.addEventListener('lostpointercapture', stopPointer)

    // 自定义拖动条：touch 兜底
    dragbar.addEventListener('touchstart', (event) => {
      const maxScroll = getMaxScroll()
      if (maxScroll <= 2 || !event.touches?.[0]) return
      dragging = true
      startX = event.touches[0].clientX
      startScrollLeft = scroller.scrollLeft
      event.preventDefault()
      event.stopPropagation()
      setScrollFromBarX(startX)
    }, { passive: false })

    dragbar.addEventListener('touchmove', (event) => {
      if (!dragging || !event.touches?.[0]) return
      event.preventDefault()
      event.stopPropagation()
      const maxScroll = getMaxScroll()
      const rect = dragbar.getBoundingClientRect()
      const dx = event.touches[0].clientX - startX
      const ratioDelta = dx / Math.max(1, rect.width)
      scroller.scrollLeft = Math.max(0, Math.min(maxScroll, startScrollLeft + ratioDelta * maxScroll))
      requestUpdate()
    }, { passive: false })

    dragbar.addEventListener('touchend', () => {
      dragging = false
    }, { passive: true })

    dragbar.addEventListener('touchcancel', () => {
      dragging = false
    }, { passive: true })

    leftButton?.addEventListener('click', (event) => {
      event.preventDefault()
      event.stopPropagation()
      scrollByStep(-1)
    })

    rightButton?.addEventListener('click', (event) => {
      event.preventDefault()
      event.stopPropagation()
      scrollByStep(1)
    })

    leftButton?.addEventListener('touchstart', (event) => {
      event.preventDefault()
      event.stopPropagation()
      scrollByStep(-1)
    }, { passive: false })

    rightButton?.addEventListener('touchstart', (event) => {
      event.preventDefault()
      event.stopPropagation()
      scrollByStep(1)
    }, { passive: false })

    dragbar.dataset.bound = '1'
    update()
    window.setTimeout(update, 80)
    window.setTimeout(update, 320)
    window.setTimeout(update, 900)
  })
  updateMobileTableControlsVisibility()
}

function updateOneTableScrollControl(wrap) {
  const scroller = wrap.querySelector('[data-table-scroll]')
  const dragbar = wrap.querySelector('[data-table-dragbar]')
  const thumb = wrap.querySelector('[data-table-dragthumb]')
  const leftButton = wrap.querySelector('[data-table-left]')
  const rightButton = wrap.querySelector('[data-table-right]')
  if (!scroller || !dragbar || !thumb) return

  const table = scroller.querySelector('table')
  const tableWidth = table ? Math.ceil(table.getBoundingClientRect().width) : 0
  const contentWidth = Math.max(scroller.scrollWidth, tableWidth)
  const maxScroll = Math.max(0, Math.ceil(contentWidth - scroller.clientWidth))
  const scrollLeft = Math.max(0, Math.min(scroller.scrollLeft, maxScroll))
  const ratio = maxScroll > 2 ? scrollLeft / maxScroll : 0

  const barWidth = Math.max(1, dragbar.clientWidth)
  const visibleRatio = scroller.scrollWidth > 0 ? Math.min(1, scroller.clientWidth / scroller.scrollWidth) : 1
  const thumbWidth = Math.max(36, Math.floor(barWidth * visibleRatio))
  const maxThumbLeft = Math.max(0, barWidth - thumbWidth)

  thumb.style.width = `${thumbWidth}px`
  thumb.style.transform = `translateX(${Math.round(maxThumbLeft * ratio)}px)`

  if (leftButton) leftButton.disabled = maxScroll <= 2 || scrollLeft <= 2
  if (rightButton) rightButton.disabled = maxScroll <= 2 || scrollLeft >= maxScroll - 2

  wrap.classList.toggle('is-scrollable', maxScroll > 2)
  dragbar.classList.toggle('is-disabled', maxScroll <= 2)
}

