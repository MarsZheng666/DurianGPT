  const buttons = Array.from(target.parentElement?.querySelectorAll?.('.markdown-table-mobile-btn, .table-scroll-arrow') || [])
  const isLeft = target.matches('[data-table-left], [data-table-mobile-left]') || buttons.indexOf(target) === 0
  const direction = isLeft ? -1 : 1
  const step = Math.max(220, Math.floor(scroller.clientWidth * 0.82))
  const maxScroll = Math.max(0, scroller.scrollWidth - scroller.clientWidth)
  const nextLeft = Math.max(0, Math.min(maxScroll, scroller.scrollLeft + direction * step))

  event.preventDefault()
  event.stopPropagation()
  scroller.scrollTo({ left: nextLeft, behavior: 'smooth' })
  window.setTimeout(() => updateOneTableScrollControl(wrap), 80)
  window.setTimeout(() => updateOneTableScrollControl(wrap), 260)
