function formatEvidenceScore(item = {}) {
  // score 是后端 rerank 排序分，可能超过 1，不能直接当百分比。
  // 前端只显示可解释的 display_score/confidence/dense_score，不显示内部 rerank score。
  const raw = Number(
    item.display_score ??
    item.confidence ??
    item.dense_score ??
    0
  )

  if (!Number.isFinite(raw) || raw <= 0) return ''

  const normalized = raw > 1 && raw <= 100 ? raw / 100 : raw
  const bounded = Math.max(0, Math.min(normalized, 0.99))
  return `${Math.round(bounded * 100)}%`
}


function getAuthHeaders() {
  const user = localStorage.getItem(CURRENT_USER_KEY) || ''
  const headers = {
    'X-API-Key': API_KEY,
  }
  if (user) {
    headers['X-User-Id'] = user
  }
  return headers
}

function getUserStorageKey(key, user = localStorage.getItem(CURRENT_USER_KEY) || 'anonymous') {
  return `durian_${user}_${key}`
}

