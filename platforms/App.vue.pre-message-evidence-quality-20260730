.message-bubble.user .message-content,
.message-bubble.user .message-content :deep(*) {
  color: white;
}

.message-content :deep(p) {
  margin: 0 0 8px 0;
  line-height: 1.6;
  color: #333;
}

.message-content :deep(p:last-child) {
  margin-bottom: 0;
}

.message-content :deep(ul),
.message-content :deep(ol) {
  margin: 8px 0;
  padding-left: 22px;
  color: #333;
}

.message-content :deep(li) {
  margin-bottom: 6px;
  line-height: 1.6;
  color: #333;
}

.message-content :deep(h1),
.message-content :deep(h2),
.message-content :deep(h3),
.message-content :deep(h4),
.message-content :deep(h5),
.message-content :deep(h6) {
  margin: 12px 0 8px;
  line-height: 1.4;
  color: #333;
  font-weight: 600;
}

.message-content :deep(h1) {
  font-size: 18px;
}

.message-content :deep(h2) {
  font-size: 16px;
}

.message-content :deep(h3) {
  font-size: 14px;
}

.message-content :deep(.markdown-table-wrap) {
  width: 100%;
  max-width: 100%;
  margin: 10px 0;
  position: relative;
}

.message-content :deep(.markdown-table-scroll) {
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-x: contain;
  touch-action: pan-x pan-y;
  padding-bottom: 8px;
  scrollbar-width: thin;
  scrollbar-color: #4CAF50 #e2e8e4;
}

.message-content :deep(.markdown-table-scroll::-webkit-scrollbar) {
  height: 12px;
}

.message-content :deep(.markdown-table-scroll::-webkit-scrollbar-track) {
  border-radius: 999px;
  background: #e2e8e4;
}

.message-content :deep(.markdown-table-scroll::-webkit-scrollbar-thumb) {
  min-width: 44px;
  border: 3px solid #e2e8e4;
  border-radius: 999px;
  background: #4CAF50;
}

.message-content :deep(.markdown-table-slider-row) {
  display: none;
  align-items: center;
  gap: 8px;
  min-height: 34px;
  margin-top: 2px;
  padding: 3px 4px 0;
  position: relative;
  z-index: 2;
  pointer-events: auto;
  user-select: none;
}

.message-content :deep(.markdown-table-wrap.is-scrollable .markdown-table-slider-row) {
  display: flex;
}

.message-content :deep(.table-scroll-arrow) {
  display: inline-flex;
  width: 26px;
  min-width: 26px;
  height: 26px;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: #e8f5e9;
  color: #2e7d32;
  font-size: 18px;
  font-weight: 800;
  line-height: 1;
  border: 0;
  padding: 0;
  cursor: pointer;
  pointer-events: auto;
  touch-action: manipulation;
  appearance: none;
  -webkit-appearance: none;
}

.message-content :deep(.table-scroll-arrow:disabled) {
  opacity: 0.38;
  cursor: default;
}

.message-content :deep(.markdown-table-range) {
  flex: 1 1 auto;
  min-width: 0;
  height: 28px;
  margin: 0;
  accent-color: #4CAF50;
  cursor: pointer;
  touch-action: pan-x;
  -webkit-appearance: none;
  appearance: none;
  background: transparent;
  pointer-events: auto;
}

.message-content :deep(.markdown-table-range:disabled) {
  opacity: 0.25;
}

.message-content :deep(.markdown-table-range::-webkit-slider-runnable-track) {
  height: 8px;
  border-radius: 999px;
  background: #d9e6db;
}

.message-content :deep(.markdown-table-range::-webkit-slider-thumb) {
  width: 24px;
  height: 24px;
  margin-top: -8px;
  border: 3px solid #ffffff;
  border-radius: 50%;
  background: #2e7d32;
  box-shadow: 0 2px 8px rgba(46, 125, 50, 0.28);
  -webkit-appearance: none;
}

.message-content :deep(.markdown-table-range::-moz-range-track) {
  height: 8px;
  border-radius: 999px;
  background: #d9e6db;
}

.message-content :deep(.markdown-table-range::-moz-range-thumb) {
  width: 20px;
  height: 20px;
  border: 3px solid #ffffff;
  border-radius: 50%;
  background: #2e7d32;
  box-shadow: 0 2px 8px rgba(46, 125, 50, 0.28);
}

.message-content :deep(table) {
  width: max-content;
  min-width: min(640px, 100%);
  max-width: none;
  border-collapse: collapse;
  font-size: 13px;
  table-layout: auto;
}

.message-content :deep(th),
.message-content :deep(td) {
  border: 1px solid #ddd;
  padding: 8px 10px;
  text-align: left;
  vertical-align: top;
  white-space: normal;
  word-break: keep-all;
  overflow-wrap: break-word;
  min-width: 120px;
  max-width: 340px;
}

.message-content :deep(th) {
